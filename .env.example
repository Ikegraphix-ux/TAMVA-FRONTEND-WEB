# Public TAMVA backend URL. This variable is public and must not contain credentials.
NEXT_PUBLIC_API_URL=https://tamva.onrender.com

# Add NEXT_PUBLIC_SITE_URL with the confirmed official HTTPS domain in Vercel Production only.
# No official domain has been confirmed yet; previews remain noindex by default.

# Enable indexing only for the confirmed official domain in Vercel Production.
# Keep false or unset for local development, preview and staging.
NEXT_PUBLIC_INDEXING_ENABLED=false
